meta {
  name: Create order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "delivery",
    "service_type": "delivery",
    "priority": "high",
    "status": "draft",
    "customer_id": "{{lastCustomerId}}",
    "customer_name": "Cliente Bruno SA",
    "driver_id": "{{lastDriverId}}",
    "driver_name": "Jose Rolando Camarena",
    "vehicle_id": "{{lastVehicleId}}",
    "vehicle_plate": "ABC-123",
    "carrier_id": "{{lastOperatorId}}",
    "workflow_id": "{{lastWorkflowId}}",
    "route_id": null,
    "origin_address": "Almacén Lima Centro",
    "origin_lat": -12.046,
    "origin_lng": -77.042,
    "origin_geofence_id": "{{lastGeofenceId}}",
    "destination_address": "Cliente Bruno SA, Av. Bruno 123",
    "destination_lat": -12.054,
    "destination_lng": -77.123,
    "destination_geofence_id": null,
    "scheduled_pickup_at": "2026-05-01T08:00:00.000Z",
    "scheduled_delivery_at": "2026-05-01T14:00:00.000Z",
    "scheduled_start_date": "2026-05-01T08:00:00.000Z",
    "scheduled_end_date": "2026-05-01T14:00:00.000Z",
