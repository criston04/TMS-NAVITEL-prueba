meta {
  name: Create order (frontend-aligned)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "delivery",
    "priority": "high",
    "customer_id": "{{lastCustomerId}}",
    "customer_name": "Cliente Bruno SA",
    "driver_id": "{{lastDriverId}}",
    "driver_name": "Jose Rolando Camarena",
    "vehicle_id": "{{lastVehicleId}}",
    "vehicle_plate": "ABC-123",
    "origin_address": "Almacén Lima Centro",
    "origin_lat": -12.046,
    "origin_lng": -77.042,
    "origin_geofence_id": "{{lastGeofenceId}}",
    "destination_address": "Cliente Bruno SA, Av. Bruno 123",
    "destination_lat": -12.054,
    "destination_lng": -77.123,
    "destination_geofence_id": null,
    "scheduled_pickup_at": "2026-05-04T08:00:00.000Z",
    "scheduled_delivery_at": "2026-05-04T14:00:00.000Z",
    "estimated_distance_km": 25.5,
    "total_weight": 1200,
    "total_volume": 4.5,
    "total_packages": 8,
    "notes": "Orden de prueba — payload limpio igual al frontend",
    "internal_notes": "Cliente VIP\n[Carga] Descripción: Fertilizante para distribución | Tipo: general | Valor declarado: 15000 USD | Manejo: Frágil, mantener seco",
    "reference": "REF-FRONT-001",
    "items": [
      {
        "product_id": "{{lastProductId}}",
        "product_name": "Fertilizante NPK",
        "quantity": 10,
        "unit": "bag",
        "weight": 500,
        "volume": 0.5,
        "notes": "Producto principal"
      }
    ]
  }
}

script:post-response {
  const body = res.getBody();
  const obj = body?.data || body;
  if (!obj) return;

  const id = obj.id || obj.order_id;
  if (id) bru.setEnvVar("lastOrderId", id);

  // Lo que MANDAMOS (igual al payload arriba — solo campos limpios)
  const sent = {
    type: "delivery",
    priority: "high",
    customer_name: "Cliente Bruno SA",
    driver_name: "Jose Rolando Camarena",
    vehicle_plate: "ABC-123",
    origin_address: "Almacén Lima Centro",
    origin_lat: -12.046,
    origin_lng: -77.042,
    destination_address: "Cliente Bruno SA, Av. Bruno 123",
    destination_lat: -12.054,
    destination_lng: -77.123,
    scheduled_pickup_at: "2026-05-04T08:00:00.000Z",
    scheduled_delivery_at: "2026-05-04T14:00:00.000Z",
    estimated_distance_km: 25.5,
    total_weight: 1200,
    total_volume: 4.5,
    total_packages: 8,
    notes: "Orden de prueba — payload limpio igual al frontend",
    internal_notes: "Cliente VIP\n[Carga] Descripción: Fertilizante para distribución | Tipo: general | Valor declarado: 15000 USD | Manejo: Frágil, mantener seco",
    reference: "REF-FRONT-001",
  };

  console.log("===================================================");
  console.log("  CREATE ORDER — payload LIMPIO (igual al frontend)");
  console.log("===================================================");
  console.log("order id:        ", id);
  console.log("order_number:    ", obj.order_number);
  console.log("");

  console.log("--- CAMPOS PLANOS (deben persistirse) ---");
  let okCount = 0, lostCount = 0, mismatchedCount = 0;
  const losses = [], mismatches = [];

  for (const key of Object.keys(sent)) {
    const expected = sent[key];
    const got = obj[key];
    if (got === null || got === undefined) {
      lostCount++;
      losses.push(key);
      console.log("  PERDIDO  ", key.padEnd(28), "→ enviado:", JSON.stringify(expected));
    } else if (got === expected || Number(got) === Number(expected)) {
      okCount++;
      console.log("  OK       ", key.padEnd(28), JSON.stringify(got));
    } else {
      mismatchedCount++;
      mismatches.push(key);
      console.log("  DIFIERE  ", key.padEnd(28), "→ env:", JSON.stringify(expected), "rec:", JSON.stringify(got));
    }
  }

  console.log("");
  console.log("--- IDS / RELACIONES ---");
  for (const k of ["customer_id", "driver_id", "vehicle_id", "workflow_id", "origin_geofence_id", "destination_geofence_id", "route_id"]) {
    const v = obj[k];
    const display = v === null || v === undefined ? "null" : JSON.stringify(v).slice(0, 50);
    console.log("  ", k.padEnd(28), "=", display);
  }

  console.log("");
  console.log("--- ITEMS ---");
  if (Array.isArray(obj.items) && obj.items.length > 0) {
    console.log("  OK persistidos:", obj.items.length, "items");
    obj.items.forEach((it, idx) => {
      console.log("    [" + idx + "] id:", it.id, "name:", it.product_name, "qty:", it.quantity);
    });
  } else {
    console.log("  PERDIDO — items[] no se persistió");
  }

  console.log("");
  console.log("--- CAMPOS QUE EL BACKEND AUTOGENERA ---");
  for (const k of ["id", "tenant_id", "order_number", "status", "created_by", "created_at", "updated_at", "sync_status"]) {
    console.log("  ", k.padEnd(28), "=", JSON.stringify(obj[k]));
  }

  console.log("");
  console.log("--- CAMPOS NULL ESPERADOS (sin GPS) ---");
  for (const k of ["current_lat", "current_lng", "actual_pickup_at", "actual_delivery_at",
                   "actual_distance_km", "actual_duration_min", "estimated_duration_min",
                   "estimated_delivery_at", "pod_signature_url", "receiver_name",
                   "vehicle_imei", "webhook_url", "sync_error_message", "last_sync_attempt"]) {
    const v = obj[k];
    const tag = v === null || v === undefined ? "null OK (esperado)" : JSON.stringify(v);
    console.log("  ", k.padEnd(28), "=", tag);
  }

  console.log("");
  console.log("==================== RESUMEN ====================");
  console.log("  OK:       ", okCount, "/ ", Object.keys(sent).length);
  console.log("  PERDIDOS: ", lostCount, losses.length ? "→ " + losses.join(", ") : "");
  console.log("  DIFIEREN: ", mismatchedCount, mismatches.length ? "→ " + mismatches.join(", ") : "");
  console.log("===================================================");
}

docs {
  # POST /orders — payload LIMPIO (idéntico al frontend en producción)

  Este request envía SOLO los campos que el backend persiste según los tests
  realizados, y que el `mapOrderToBackend()` del frontend produce realmente
  DESPUÉS de los 5 fixes aplicados el 2026-05-03.

  ## Diferencia con `02-Create-EXHAUSTIVE.bru`

  El archivo `EXHAUSTIVE` envía TODOS los campos posibles para descubrir cuáles
  persiste el backend (test exploratorio). Este archivo refleja el payload
  limpio que el frontend envía hoy en producción.

  ## Campos eliminados intencionalmente (vs EXHAUSTIVE)

  - `service_type`        → backend solo usa `type`
  - `carrier_id`          → backend NO soporta carrier en orders
  - `external_reference`  → backend solo usa `reference`
  - `scheduled_start_date`/`scheduled_end_date` → solo *_pickup_at/*_delivery_at
  - `tags[]`              → backend NO implementa tags
  - `cargo{}` sub-objeto  → backend usa total_* planos
  - `milestones[]` array  → backend usa origin_*/destination_* planos
  - `gps_operator_id`     → backend NO soporta gps_operator
  - `route_id`            → solo se envía si viene del DTO

  ## Fixes del frontend reflejados en este payload

  ### Fix A — Hidratación de denormalizaciones
  El frontend ahora SIEMPRE envía customer_name, vehicle_plate, driver_name
  resueltos desde sus listados locales. Antes el backend devolvía null en
  estos campos aunque los IDs fueran válidos.

  ### Fix B — Preservación de metadata de carga en internal_notes
  Los datos extra de la carga (description, type, declaredValue,
  handlingInstructions, temperatureRange) que el backend NO soporta como
  columnas dedicadas, se concatenan en `internal_notes` con prefijo `[Carga]`.

  Formato: `<notas internas del usuario>\n[Carga] Clave1: valor1 | Clave2: valor2 | ...`

  Ejemplo en este request:
  ```
  internal_notes: "Cliente VIP\n[Carga] Descripción: Fertilizante para distribución | Tipo: general | Valor declarado: 15000 USD | Manejo: Frágil, mantener seco"
  ```

  ### Fix C — Validación zod permisiva en draft
  El zod `createOrderSchema` ahora permite milestones y fechas opcionales.
  Solo customerId, priority, serviceType, cargo.description y cargo.weightKg
  son required al crear un draft. La validación strict ocurre en
  `orderReadyForSchedulingSchema` cuando la orden quiere transicionar a
  pending/assigned/in_transit.

  ### Fix D — Fechas independientes de hitos
  El wizard tiene una nueva sección "Programación" en el paso 1 con dos
  campos: fecha+hora de recojo y fecha+hora de entrega. Si el usuario las
  rellena, tienen prioridad sobre las fechas derivadas de los milestones.
  Esto permite enviar `scheduled_pickup_at` y `scheduled_delivery_at` sin
  necesidad de crear hitos primero.

  ### Fix E — Banners informativos en el wizard
  En el paso 4 (Confirmación) aparecen banners explicando:
  - Banner ámbar: si faltan datos para programar (la orden quedará en draft)
  - Banner azul: si rellenó campos no soportados (carrier, tags, declared_value)

  ## Requisito previo

  Ejecutar antes los `01-List.bru` de:
    - 03-Master-Customers
    - 04-Master-Drivers
    - 05-Master-Vehicles
    - 06-Master-Products  (si quieres items con product_id real)
    - 02-Geofences (opcional, si quieres origin_geofence_id real)

  Para que las variables `{{lastXxxId}}` queden pobladas en el environment.

  ## Lo que vas a ver en el output

  El script post-response imprime:
  1. Tabla de campos OK / PERDIDOS / DIFIEREN
  2. Estado de IDs y relaciones (customer_id, driver_id, etc.)
  3. Items persistidos con sus UUIDs generados
  4. Campos autogenerados por backend (id, order_number, status, etc.)
  5. Campos null esperados (sin GPS conectado)

  ## Resultado esperado (cuando todo funciona)

  - 19 campos OK persistidos
  - 0 PERDIDOS
  - 0 DIFIEREN (excepto timestamps que se redondean al segundo)
  - items[] con UUIDs generados por backend
  - Status devuelto: "draft"
  - internal_notes contiene tanto las notas del usuario como la metadata
    de carga prefijada con `[Carga]`
}
