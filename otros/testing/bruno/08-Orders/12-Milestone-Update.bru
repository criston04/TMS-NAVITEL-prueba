meta {
  name: Update milestone
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/orders/{{lastOrderId}}/milestones/{{lastMilestoneId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "completed",
    "actual_arrival": "2026-04-22T08:20:00.000Z",
    "actual_departure": "2026-04-22T08:45:00.000Z",
    "notes": "Milestone completado por el conductor."
  }
}

docs {
  # PATCH /orders/:orderId/milestones/:milestoneId

  Actualiza el estado de un milestone (origin/waypoint/destination) de una orden.
  Frontend lo invoca desde `OrderService.updateMilestone()`.

  Setear `lastMilestoneId` manualmente luego de obtener una orden con milestones populados.
}
