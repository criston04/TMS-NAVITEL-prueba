meta {
  name: Update order (PATCH)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/orders/{{lastOrderId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "priority": "high",
    "status": "confirmed",
    "type": "distribucion",
