meta {
  name: Create driver
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/master/drivers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

