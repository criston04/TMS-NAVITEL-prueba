meta {
  name: List drivers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/master/drivers?page=1&pageSize=5
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 5
}

auth:bearer {
  token: {{authToken}}
}

docs {
  # GET /master/drivers

  Proposito: verificar si usa `firstName`, `lastName`, `licenseNumber` limpio
  o con prefijo como `dname`, `dfirstname`.
}
