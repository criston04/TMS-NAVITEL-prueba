meta {
  name: Create operator
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/master/operators
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

