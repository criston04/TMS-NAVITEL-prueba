meta {
  name: Update customer (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/master/customers/{{lastCustomerId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Cliente Bruno SA ACTUALIZADO",
    "trade_name": "Bruno Corp ACTUALIZADO",
    "email": "bruno-updated@test.com",
    "phone": "+51 999 888 999",
    "phone2": "+51 999 888 991",
    "website": "https://brunocorp-updated.test",
    "category": "premium",
    "credit_limit": 80000,
    "credit_used": 12500,
    "notes": "Cliente upgradeado a premium (update desde Bruno).",
    "address": "Av. Bruno 123, Lima, Lima, PE",
    "addresses": [
      {
        "id": "addr-001",
        "label": "Sede principal",
        "street": "Av. Bruno 123",
        "city": "Lima",
        "state": "Lima",
        "country": "PE",
        "zip_code": "15001",
        "is_default": true,
        "lat": -12.0837,
