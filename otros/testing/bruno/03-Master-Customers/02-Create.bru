meta {
  name: Create customer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/master/customers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

