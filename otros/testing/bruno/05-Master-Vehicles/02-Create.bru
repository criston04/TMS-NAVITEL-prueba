meta {
  name: Create vehicle
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/master/vehicles
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

