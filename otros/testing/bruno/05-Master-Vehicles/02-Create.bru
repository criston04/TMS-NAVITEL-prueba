script:post-response {
  const body = res.getBody();
  const obj = body?.data || body;
  if (!obj) return;

  const id = obj.id;
  if (id) bru.setEnvVar("lastVehicleId", id);

  // Espejo de mapVehicleToBackend()
  const sent = {
    code: "VEH-001",
    plate: "ABC-123",
    type: "truck",
    body_type: "furgon",
    brand: "Volvo",
    model: "FH16",
    year: 2024,
    vin: "YV2RT40A8XB123456",
    color: "Blanco",
    fuel_type: "diesel",
    operational_status: "available",
    status: "active",
    current_mileage: 0,
    notes: "Vehículo de prueba",
    capacity_kg: 25000,
    capacity_m3: 80,
  };

  function valueMatches(expected, got) {
    if (got === null || got === undefined) return false;
    return got === expected;
  }

  console.log("===================================================");
  console.log("            VERIFICACION CREATE VEHICLE            ");
  console.log("===================================================");
  console.log("vehicle id:", id);
  console.log("");
  console.log("--- CAMPOS PLANOS ---");

  const ok = [], lost = [], mismatched = [];
  for (const key of Object.keys(sent)) {
    const expected = sent[key];
    const got = obj[key];
    if (got === null || got === undefined) {
      lost.push(key);
      console.log("  ❌", key.padEnd(22), "PERDIDO — env:", JSON.stringify(expected));
    } else if (valueMatches(expected, got)) {
      ok.push(key);
      console.log("  ✅", key.padEnd(22), JSON.stringify(got));
    } else {
      mismatched.push(key);
      console.log("  ⚠️ ", key.padEnd(22), "DIFIERE — env:", JSON.stringify(expected), "rec:", JSON.stringify(got));
    }
  }

  console.log("");
  console.log("--- CAMPOS NULL (esperado: trailer_plate, gps_device_id, operator_id) ---");
  for (const k of ["trailer_plate", "gps_device_id", "operator_id"]) {
    console.log("  ", k.padEnd(22), "=", JSON.stringify(obj[k]));
  }

  console.log("");
  console.log("--- SUB-OBJETOS / RELACIONALES ---");
  console.log("  specs{}:           ", obj.specs              ? "✅ persistido" : "❌ DESCARTADO");
  console.log("  capacity{}:        ", obj.capacity           ? "✅ persistido" : "❌ DESCARTADO");
  console.log("  insurance{}:       ", obj.insurance          ? "✅ persistido" : "❌ DESCARTADO");
  console.log("  insurance_policies:", Array.isArray(obj.insurance_policies) ? "✅ persistido (" + obj.insurance_policies.length + ")" : "❌ DESCARTADO");
  console.log("  registration{}:    ", obj.registration       ? "✅ persistido" : "❌ DESCARTADO");
  console.log("  documents[]:       ", Array.isArray(obj.documents) && obj.documents.length > 0 ? "✅ persistido (" + obj.documents.length + ")" : "❌ DESCARTADO");

  console.log("");
  console.log("--- CAMPOS EXTRA QUE AGREGA EL BACKEND ---");
  const expectedKeys = new Set([...Object.keys(sent), "id", "trailer_plate", "gps_device_id", "operator_id", "specs", "capacity", "insurance", "insurance_policies", "registration", "documents"]);
  const extras = Object.keys(obj).filter(k => !expectedKeys.has(k));
  for (const k of extras) {
    console.log("  +", k.padEnd(28), "=", JSON.stringify(obj[k]));
  }

  console.log("");
  console.log("==================== RESUMEN ====================");
  console.log("  OK:        ", String(ok.length).padEnd(3));
  console.log("  PERDIDOS:  ", String(lost.length).padEnd(3), lost.length ? "→ " + lost.join(", ") : "");
  console.log("  DIFIERE:   ", String(mismatched.length).padEnd(3), mismatched.length ? "→ " + mismatched.join(", ") : "");
  console.log("  EXTRA BE:  ", String(extras.length).padEnd(3));
  console.log("===================================================");
}

docs {
  # POST /master/vehicles — payload IDÉNTICO al que produce el frontend hoy

  Refleja `mapVehicleToBackend()` tras los fixes de 2026-04-30:
  - Ahora se manda `insurance` SINGULAR (la primera póliza) además del array
    `insurance_policies` completo. Esto porque la doc del backend dice que
    el POST acepta `insurance` como objeto singular.

  ## ⚠ Sub-objetos NO persistidos (BACKEND_GAPS.md)
  El backend acepta el body completo (no devuelve 400) pero solo persiste los
  planos. Estos sub-objetos quedan en deuda:
  - `specs{}` (engine_number, axles, tires, transmission, …)
  - `capacity{}` (max_weight_kg, max_pallets, gross/tare weight)
  - `insurance{}` y `insurance_policies[]`
  - `registration{}` (SUNARP)
  - `documents[]` (SOAT, RT)

  ## ⚠ Bug del backend
  - `code` se envía pero el backend siempre lo devuelve `null`
}
