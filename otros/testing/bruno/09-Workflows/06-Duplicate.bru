meta {
  name: Duplicate workflow
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/workflows/{{lastWorkflowId}}/duplicate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newName": "WF Trigger Test COPIA"
  }
}

docs {
  # POST /workflows/:id/duplicate

  Crea un workflow nuevo copiando el original.
  Response minimo: `{"data": {"id": "...", "name": "..."}}`.

  Para obtener el resto de campos del duplicado, hacer GET al id devuelto.
}
