meta {
  name: Update invoice (PUT, not PATCH)
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/finance/invoices/{{lastInvoiceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "notes": "Factura actualizada desde Bruno",
    "internalNotes": "Revisada por el area contable"
  }
}

docs {
  # PUT /finance/invoices/:id

  **Solo PUT** — `PATCH` responde 405 Method Not Allowed.

  Update parcial. Response 200 con el invoice completo actualizado.
}
