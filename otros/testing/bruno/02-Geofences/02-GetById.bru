meta {
  name: Get geofence by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/master/geofences/{{lastGeofenceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  # GET /geofences/:id — Detalle

  **Excel:** `Geofence | GET | /geofences/:id`

  Usa `lastGeofenceId` (guardado por el endpoint List).
  Para probar con otro id, editar la URL o setear manualmente la env var.
}
